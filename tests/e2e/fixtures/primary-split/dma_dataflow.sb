# DMA データフロー図
@canvas width=960 height=520 grid=20
block DMADrv "DMADrv" at 4,4 size 8x3 color=#6366F1 text=#FFFFFF round=4
block dmadata "DMAData" at 14,4 size 8x3 color=#0EA5E9 text=#FFFFFF round=4
block rte "RTE" at 24,4 size 8x3 color=#3B82F6 text=#FFFFFF round=4
DMADrv -> dmadata
dmadata -> rte
