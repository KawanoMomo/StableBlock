# I2C データフロー図
@canvas width=960 height=520 grid=20
block I2CDrv "I2CDrv" at 4,4 size 8x3 color=#6366F1 text=#FFFFFF round=4
block i2cdata "I2CData" at 14,4 size 8x3 color=#0EA5E9 text=#FFFFFF round=4
block rte "RTE" at 24,4 size 8x3 color=#3B82F6 text=#FFFFFF round=4
I2CDrv -> i2cdata
i2cdata -> rte
